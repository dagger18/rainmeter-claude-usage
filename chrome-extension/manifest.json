{
  "manifest_version": 3,
  "name": "Claude Usage Monitor",
  "version": "1.0",
  "description": "Feeds Claude usage data to the Rainmeter desktop widget",
  "permissions": [
    "nativeMessaging",
    "tabs",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://discordapp.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
